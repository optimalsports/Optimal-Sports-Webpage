# Vercel KV Redis Database (for order storage)
# These will be automatically populated when you add KV database in Vercel dashboard
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# Printful API Integration (for product fulfillment)
# Get this from: https://www.printful.com/dashboard/store → Settings → API
PRINTFUL_API_KEY="your_printful_api_key_here"

# Stripe Payment Processing
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Stripe Webhook Secret (IMPORTANT for reliable order processing)
# Get this from: https://dashboard.stripe.com/webhooks
# After creating webhook endpoint: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Optional: For development, you can use a different API base URL
# NEXT_PUBLIC_API_BASE="http://localhost:3000"

